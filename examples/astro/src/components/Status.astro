---
import PreferencesButton from '@notabenda/core/astro/PreferencesButton.astro';
---
<section>
  <h2>At your discretion</h2>
  <p data-astro-purpose="measurement">Measurement: Off — waiting for your choice</p>
  <p data-astro-purpose="suggestions">Suggestions: Off — waiting for your choice</p>
  <p>Sample services: <output data-astro-services aria-label="Sample service lifecycle states">blocked · blocked</output></p>
  <p>Optional requests in this visit: <output data-astro-requests aria-label="Optional requests in this visit">0</output></p>
  <p data-astro-status>Optional features wait until your choices are available.</p>
  <PreferencesButton class="nb-choice-button">Review your choices</PreferencesButton>
</section>
