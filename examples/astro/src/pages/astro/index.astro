---
// @requirements REQ-PRODUCT-ASTRO
import InteractiveLayout from '../../layouts/InteractiveLayout.astro';
import Status from '../../components/Status.astro';
---
<InteractiveLayout title="Considered by default">
  <main id="main" class="nb-document">
    <p class="nb-eyebrow">Notabenda · Astro example</p>
    <h1>Small pages.<br />Considered choices.</h1>
    <p>Ordinary HTML, a little browser code, and room for your own design. The same consent controller stays with you as you move between these example pages.</p>
    <p class="hint">Optional services wait for your choice.</p>
    <Status />
    <section><h2>A choice that travels with you</h2><p><a href="/astro/notes/">Visit the next page</a> to keep your current choice through Astro navigation. Refusal stays refused; visiting a page does not ask you to choose again.</p><p><a href="/astro/requests/" data-astro-reload>Explore script-free privacy request entry points →</a></p></section>
    <noscript><p>JavaScript is unavailable. Optional services stay off; the legal pages below still work.</p></noscript>
  </main>
</InteractiveLayout>
