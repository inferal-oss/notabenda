---
// @requirements REQ-PRODUCT-ASTRO
import InteractiveLayout from '../../layouts/InteractiveLayout.astro';
import Status from '../../components/Status.astro';
---
<InteractiveLayout title="Astro cookie controls">
  <main id="main" class="nb-document">
    <p class="nb-eyebrow">Notabenda · Astro example</p>
    <h1>Cookie controls<br />with Astro</h1>
    <p>Static HTML and a shared consent controller keep your choices through Astro page navigation.</p>
    <p class="hint">Optional services wait for your choice.</p>
    <Status />
    <section><h2>Navigate without resetting choices</h2><p><a href="/astro/notes/">Visit the next page</a> to keep your current choice through Astro navigation. Refusal stays refused; visiting a page does not ask you to choose again.</p><p><a href="/astro/requests/" data-astro-reload>Explore script-free privacy request entry points →</a></p></section>
    <noscript><p>JavaScript is unavailable. Optional services stay off; the legal pages below still work.</p></noscript>
  </main>
</InteractiveLayout>
