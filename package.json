{
  "name": "notabenda-workspace",
  "private": true,
  "license": "(Apache-2.0 OR MIT)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run build && node --test packages/*/test/*.test.mjs",
    "check": "npm test && python3 scripts/regulatory.py --check && python3 scripts/build-service-catalog.py --check && node site/build.mjs && node --test site/test/*.test.mjs && node scripts/site-wrangler.mjs deploy --dry-run --config site/wrangler.jsonc --outdir dist/site-worker",
    "example": "npm run build && node examples/static/build.mjs",
    "dev": "npm run site:build && node scripts/serve-example.mjs",
    "site:build": "npm run build && node site/build.mjs",
    "site:key": "node scripts/init-site-key.mjs",
    "site:dev": "npm run site:build && node scripts/site-wrangler.mjs dev --config site/wrangler.jsonc --ip 127.0.0.1 --port 4179 --persist-to .local/site-state",
    "site:check": "npm run site:build && node --test site/test/*.test.mjs && node scripts/site-wrangler.mjs deploy --dry-run --config site/wrangler.jsonc --outdir dist/site-worker",
    "a11y:check": "node scripts/audit-accessibility.mjs",
    "a11y:fixture": "node scripts/build-accessibility-fixture.mjs",
    "a11y:serve": "node scripts/serve-accessibility.mjs",
    "example:astro": "npm run build && node examples/astro/build.mjs",
    "site:build:production": "npm run build && node site/build.mjs --production",
    "size": "npm run build && node scripts/measure-bundles.mjs",
    "size:check": "npm run build && node scripts/measure-bundles.mjs --check",
    "perf": "npm run build && node scripts/measure-consent-performance.mjs",
    "perf:fixture": "npm run build && node scripts/build-performance-fixture.mjs",
    "perf:serve": "node scripts/serve-performance.mjs",
    "release:check": "node scripts/check-package-release.mjs",
    "cf:recovery:remote": "node scripts/check-cf-remote-recovery.mjs",
    "cf:recovery:transactions": "node scripts/check-transaction-recovery.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "astro": "7.4.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "26.1.0",
    "jsqr": "1.4.0",
    "marked": "18.1.1",
    "mdast-util-from-markdown": "2.1.0",
    "postcss": "8.5.31",
    "shiki": "4.5.0",
    "typescript": "7.0.2",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
