---
// @requirements REQ-EU-GUARANTEE-NOTICE REQ-PRODUCT-GUARANTEE-NOTICE REQ-PRODUCT-ASTRO
import {renderLegalGuaranteeNotice} from '../guarantee-notice.js';
export interface Props {notice:unknown;idPrefix:string;headingLevel?:2|3|4|5|6;allowPreview?:boolean;class?:string}
const {notice,idPrefix,headingLevel,allowPreview=false,class:className}=Astro.props;
const html=renderLegalGuaranteeNotice(notice,{idPrefix,allowPreview,...(headingLevel===undefined?{}:{headingLevel})});
---
<div class={className} set:html={html} />
