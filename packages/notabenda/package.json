{
  "name": "notabenda",
  "version": "0.1.0",
  "description": "Reusable site configuration and static privacy, cookie, and terms documents.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "./dist/styles.css",
    "./dist/consent.css",
    "./dist/services.css",
    "./dist/guarantees.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "assets/guarantees"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./collection/indirect": {
      "types": "./dist/indirect-collection.d.ts",
      "import": "./dist/indirect-collection.js",
      "default": "./dist/indirect-collection.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js",
      "default": "./dist/content.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./react/documents": {
      "types": "./dist/react-documents.d.ts",
      "import": "./dist/react-documents.js",
      "default": "./dist/react-documents.js"
    },
    "./astro/client": {
      "types": "./dist/astro-client.d.ts",
      "import": "./dist/astro-client.js",
      "default": "./dist/astro-client.js"
    },
    "./astro/*.astro": "./dist/astro/*.astro",
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js",
      "default": "./dist/setup.js"
    },
    "./setup/ui": {
      "types": "./dist/setup-ui.d.ts",
      "import": "./dist/setup-ui.js",
      "default": "./dist/setup-ui.js"
    },
    "./setup/purposes": {
      "types": "./dist/setup-purpose.d.ts",
      "import": "./dist/setup-purpose.js",
      "default": "./dist/setup-purpose.js"
    },
    "./setup/purposes/ui": {
      "types": "./dist/setup-purpose-ui.d.ts",
      "import": "./dist/setup-purpose-ui.js",
      "default": "./dist/setup-purpose-ui.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js",
      "default": "./dist/discovery.js"
    },
    "./discovery/ui": {
      "types": "./dist/discovery-ui.d.ts",
      "import": "./dist/discovery-ui.js",
      "default": "./dist/discovery-ui.js"
    },
    "./google": {
      "types": "./dist/google-basic.d.ts",
      "import": "./dist/google-basic.js",
      "default": "./dist/google-basic.js"
    },
    "./contracts": {
      "types": "./dist/contract-action.d.ts",
      "import": "./dist/contract-action.js",
      "default": "./dist/contract-action.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    },
    "./consent.css": "./dist/consent.css",
    "./consent": {
      "types": "./dist/consent-runtime.d.ts",
      "import": "./dist/consent-runtime.js",
      "default": "./dist/consent-runtime.js"
    },
    "./consent/evidence": {
      "types": "./dist/consent-runtime-evidence.d.ts",
      "import": "./dist/consent-runtime-evidence.js",
      "default": "./dist/consent-runtime-evidence.js"
    },
    "./react/consent": {
      "types": "./dist/react-consent.d.ts",
      "import": "./dist/react-consent.js",
      "default": "./dist/react-consent.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./catalog/seed": {
      "types": "./dist/catalog-seed.d.ts",
      "import": "./dist/catalog-seed.js",
      "default": "./dist/catalog-seed.js"
    },
    "./catalog/browser": {
      "types": "./dist/catalog-browser.d.ts",
      "import": "./dist/catalog-browser.js",
      "default": "./dist/catalog-browser.js"
    },
    "./catalog/browser/seed": {
      "types": "./dist/catalog-browser-seed.d.ts",
      "import": "./dist/catalog-browser-seed.js",
      "default": "./dist/catalog-browser-seed.js"
    },
    "./catalog/browser/ui": {
      "types": "./dist/catalog-browser-ui.d.ts",
      "import": "./dist/catalog-browser-ui.js",
      "default": "./dist/catalog-browser-ui.js"
    },
    "./catalog/project": {
      "types": "./dist/catalog-project.d.ts",
      "import": "./dist/catalog-project.js",
      "default": "./dist/catalog-project.js"
    },
    "./catalog/schema.json": "./dist/catalog/schema.json",
    "./services": {
      "types": "./dist/service-directory.d.ts",
      "import": "./dist/service-directory.js",
      "default": "./dist/service-directory.js"
    },
    "./services.css": "./dist/services.css",
    "./catalog/selection": {
      "types": "./dist/catalog-selection.d.ts",
      "import": "./dist/catalog-selection.js",
      "default": "./dist/catalog-selection.js"
    },
    "./catalog/ui": {
      "types": "./dist/catalog-ui.d.ts",
      "import": "./dist/catalog-ui.js",
      "default": "./dist/catalog-ui.js"
    },
    "./catalog/review": {
      "types": "./dist/catalog-review.d.ts",
      "import": "./dist/catalog-review.js",
      "default": "./dist/catalog-review.js"
    },
    "./catalog/release": {
      "types": "./dist/catalog-release.d.ts",
      "import": "./dist/catalog-release.js",
      "default": "./dist/catalog-release.js"
    },
    "./catalog/profile": {
      "types": "./dist/catalog-profile.d.ts",
      "import": "./dist/catalog-profile.js",
      "default": "./dist/catalog-profile.js"
    },
    "./guarantees": {
      "types": "./dist/guarantee-notice.d.ts",
      "import": "./dist/guarantee-notice.js",
      "default": "./dist/guarantee-notice.js"
    },
    "./guarantees/content": {
      "types": "./dist/guarantee-notice-build.d.ts",
      "import": "./dist/guarantee-notice-build.js",
      "default": "./dist/guarantee-notice-build.js"
    },
    "./guarantees.css": "./dist/guarantees.css",
    "./guarantees/label": {
      "types": "./dist/guarantee-label.d.ts",
      "import": "./dist/guarantee-label.js",
      "default": "./dist/guarantee-label.js"
    }
  },
  "bin": {
    "notabenda": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "19.3.1",
    "@types/react": "19.3.0"
  }
}
