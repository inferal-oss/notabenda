{
  "name": "notabenda-authoring",
  "version": "0.1.0",
  "description": "Optional Markdown and MDX legal-document authoring with YAML frontmatter and private source history.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "notabenda": "0.1.0",
    "@mdx-js/mdx": "3.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "unified": "11.0.5",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "@types/react": "19.3.0"
  },
  "devDependencies": {
    "@types/react-dom": "19.3.0",
    "@types/hast": "3.0.5"
  }
}
