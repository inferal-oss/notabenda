{
  "name": "@notabenda/authoring",
  "version": "0.1.0",
  "description": "Optional Markdown and MDX legal-document authoring with YAML frontmatter and private source history.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./guarantees": {
      "types": "./dist/guarantee-label-build.d.ts",
      "import": "./dist/guarantee-label-build.js",
      "default": "./dist/guarantee-label-build.js"
    },
    "./orders": {
      "types": "./dist/paid-order-build.d.ts",
      "import": "./dist/paid-order-build.js",
      "default": "./dist/paid-order-build.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "default": "./dist/preview.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@notabenda/core": "0.1.0",
    "@mdx-js/mdx": "3.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "unified": "11.0.5",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "@types/react": "19.3.0",
    "@xmldom/xmldom": "0.9.12",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/react-dom": "19.3.0",
    "@types/hast": "3.0.5",
    "@types/pngjs": "6.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://notabenda.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inferal-oss/notabenda.git",
    "directory": "packages/notabenda-authoring"
  },
  "bugs": {
    "url": "https://github.com/inferal-oss/notabenda/issues"
  }
}
