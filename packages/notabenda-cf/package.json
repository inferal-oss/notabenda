{
  "name": "notabenda-cf",
  "version": "0.1.0",
  "description": "Optional Cloudflare evidence storage, contract handoff runners and host-authorized backoffice.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples",
    "bin",
    "templates"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./orders": {
      "types": "./dist/orders.d.ts",
      "import": "./dist/orders.js",
      "default": "./dist/orders.js"
    }
  },
  "scripts": {
    "build": "node scripts/sync-order-policy.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "notabenda-cf": "./bin/notabenda-cf.mjs"
  }
}
