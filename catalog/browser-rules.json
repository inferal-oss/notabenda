    {
      "id": "posthog-browser",
      "revision": "2026-10-19.1",
      "productId": "posthog-analytics",
      "sourceIds": [
        "browser-posthog-cookie",
        "browser-posthog-loader",
        "browser-posthog-regions"
      ],
      "explanation": "A cloud asset loader, or a cookie-name pattern together with an own posthog object, is reported.",
      "caveats": [
        "Custom persistence names, self-hosting and proxies may not match.",
        "A storage name can be stale and an object can be a bootstrap stub; no values or events are read."
      ],
      "signals": [
        {
          "id": "loader",
          "kind": "resource",
          "hosts": [
            "us-assets.i.posthog.com",
            "eu-assets.i.posthog.com"
          ],
          "subdomains": false,
          "path": {
            "match": "exact",
            "value": "/static/array.js"
          },
          "resourceType": "script",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        },
        {
          "id": "cookie",
          "kind": "storage",
          "storageType": "cookie",
          "name": {
            "match": "glob",
            "value": "ph_*_posthog"
          }
        },
        {
          "id": "api",
          "kind": "global",
          "name": "posthog",
          "valueType": "object"
        }
      ],
      "anyOf": [
        {
          "allOf": [
            "loader"
          ]
        },
        {
          "allOf": [
            "cookie",
            "api"
          ]
        }
      ]
    },
