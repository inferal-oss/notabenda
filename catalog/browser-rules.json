{
  "schemaVersion": 1,
  "kind": "notabenda-browser-rules",
  "matcherVersion": 1,
  "id": "notabenda-browser-signatures",
  "revision": "2026-10-19.1",
  "rules": [
    {
      "id": "google-tag-script",
      "revision": "2026-10-19.1",
      "productId": "google-tag",
      "sourceIds": [
        "browser-google-tag"
      ],
      "explanation": "Google tag loader path and an own gtag function are reported in this capture.",
      "caveats": [
        "The tag supports multiple destinations; this rule does not identify Analytics, Ads or a particular account.",
        "The function may be a bootstrap stub and a DOM reference may never have executed."
      ],
      "signals": [
        {
          "id": "loader",
          "kind": "resource",
          "hosts": [
            "www.googletagmanager.com"
          ],
          "subdomains": false,
          "path": {
            "match": "exact",
            "value": "/gtag/js"
          },
          "resourceType": "script",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        },
        {
          "id": "api",
          "kind": "global",
          "name": "gtag",
          "valueType": "function"
        }
      ],
      "anyOf": [
        {
          "allOf": [
            "loader",
            "api"
          ]
        }
      ]
    },
    {
      "id": "google-tag-manager-path",
      "revision": "2026-10-19.1",
      "productId": "google-tag-manager",
      "sourceIds": [
        "browser-google-gtm"
      ],
      "explanation": "The script or frame path matches a Tag Manager container reference.",
      "caveats": [
        "Configured tags and container identifiers are not inspected.",
        "A frame reference or buffered entry does not establish which tags executed."
      ],
      "signals": [
        {
          "id": "script",
          "kind": "resource",
          "hosts": [
            "www.googletagmanager.com"
          ],
          "subdomains": false,
          "path": {
            "match": "exact",
            "value": "/gtm.js"
          },
          "resourceType": "script",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        },
        {
          "id": "frame",
          "kind": "resource",
          "hosts": [
            "www.googletagmanager.com"
          ],
          "subdomains": false,
          "path": {
            "match": "exact",
            "value": "/ns.html"
          },
          "resourceType": "frame",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        }
      ],
      "anyOf": [
        {
          "allOf": [
            "script"
          ]
        },
        {
          "allOf": [
            "frame"
          ]
        }
      ]
    },
    {
      "id": "stripe-loader-path",
      "revision": "2026-10-19.1",
      "productId": "stripe-payments",
      "sourceIds": [
        "browser-stripe-js",
        "browser-stripe-version"
      ],
      "explanation": "The Stripe delivery host and a versioned or legacy loader path match a script observation.",
      "caveats": [
        "No payment operation, loaded feature or data transfer is established.",
        "Future loader paths and first-party proxies can require rule updates."
      ],
      "signals": [
        {
          "id": "versioned",
          "kind": "resource",
          "hosts": [
            "js.stripe.com"
          ],
          "subdomains": false,
          "path": {
            "match": "glob",
            "value": "/*/stripe.js"
          },
          "resourceType": "script",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        },
        {
          "id": "legacy",
          "kind": "resource",
          "hosts": [
            "js.stripe.com"
          ],
          "subdomains": false,
          "path": {
            "match": "exact",
            "value": "/v3/"
          },
          "resourceType": "script",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        },
        {
          "id": "legacy-no-slash",
          "kind": "resource",
          "hosts": [
            "js.stripe.com"
          ],
          "subdomains": false,
          "path": {
            "match": "exact",
            "value": "/v3"
          },
          "resourceType": "script",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        }
      ],
      "anyOf": [
        {
          "allOf": [
            "versioned"
          ]
        },
        {
          "allOf": [
            "legacy"
          ]
        },
        {
          "allOf": [
            "legacy-no-slash"
          ]
        }
      ]
    },
    {
      "id": "stripe-script-host",
      "revision": "2026-10-19.1",
      "productId": "stripe-payments",
      "sourceIds": [
        "browser-stripe-js"
      ],
      "explanation": "A script observation names the documented Stripe delivery host.",
      "caveats": [
        "This is an origin-only hint, deliberately weaker than a loader-path match.",
        "An origin/name-only historical capture can satisfy this rule; it cannot identify a loader version."
      ],
      "signals": [
        {
          "id": "host",
          "kind": "resource",
          "hosts": [
            "js.stripe.com"
          ],
          "subdomains": false,
          "path": null,
          "resourceType": "script",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        }
      ],
      "anyOf": [
        {
          "allOf": [
            "host"
          ]
        }
      ]
    },
    {
      "id": "turnstile-browser",
      "revision": "2026-10-19.1",
      "productId": "cloudflare-turnstile",
      "sourceIds": [
        "browser-turnstile"
      ],
      "explanation": "A documented loader path, or a div marker together with an own API object, is reported.",
      "caveats": [
        "A marker by itself is only a partial hint.",
        "No widget call, challenge, token or server validation is performed or inspected."
      ],
      "signals": [
        {
          "id": "loader",
          "kind": "resource",
          "hosts": [
            "challenges.cloudflare.com"
          ],
          "subdomains": false,
          "path": {
            "match": "exact",
            "value": "/turnstile/v0/api.js"
          },
          "resourceType": "script",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        },
        {
          "id": "container",
          "kind": "marker",
          "tag": "div",
          "classToken": "cf-turnstile"
        },
        {
          "id": "api",
          "kind": "global",
          "name": "turnstile",
          "valueType": "object"
        }
      ],
      "anyOf": [
        {
          "allOf": [
            "loader"
          ]
        },
        {
          "allOf": [
            "container",
            "api"
          ]
        }
      ]
    },
    {
      "id": "intercom-widget",
      "revision": "2026-10-19.1",
      "productId": "intercom-support",
      "sourceIds": [
        "browser-intercom"
      ],
      "explanation": "The widget loader prefix and an own Intercom function are reported.",
      "caveats": [
        "The function can be a queue stub; this does not establish initialization or message processing.",
        "Workspace IDs, user details and SDK settings are not inspected."
      ],
      "signals": [
        {
          "id": "loader",
          "kind": "resource",
          "hosts": [
            "widget.intercom.io"
          ],
          "subdomains": false,
          "path": {
            "match": "prefix",
            "value": "/widget/"
          },
          "resourceType": "script",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        },
        {
          "id": "api",
          "kind": "global",
          "name": "Intercom",
          "valueType": "function"
        }
      ],
      "anyOf": [
        {
          "allOf": [
            "loader",
            "api"
          ]
        }
      ]
    },
    {
      "id": "posthog-browser",
      "revision": "2026-10-19.1",
      "productId": "posthog-analytics",
      "sourceIds": [
        "browser-posthog-cookie",
        "browser-posthog-loader",
        "browser-posthog-regions"
      ],
      "explanation": "A cloud asset loader, or a cookie-name pattern together with an own posthog object, is reported.",
      "caveats": [
        "Custom persistence names, self-hosting and proxies may not match.",
        "A storage name can be stale and an object can be a bootstrap stub; no values or events are read."
      ],
      "signals": [
        {
          "id": "loader",
          "kind": "resource",
          "hosts": [
            "us-assets.i.posthog.com",
            "eu-assets.i.posthog.com"
          ],
          "subdomains": false,
          "path": {
            "match": "exact",
            "value": "/static/array.js"
          },
          "resourceType": "script",
          "channels": [
            "resource-entry",
            "dom-reference"
          ]
        },
        {
          "id": "cookie",
          "kind": "storage",
          "storageType": "cookie",
          "name": {
            "match": "glob",
            "value": "ph_*_posthog"
          }
        },
        {
          "id": "api",
          "kind": "global",
          "name": "posthog",
          "valueType": "object"
        }
      ],
      "anyOf": [
        {
          "allOf": [
            "loader"
          ]
        },
        {
          "allOf": [
            "cookie",
            "api"
          ]
        }
      ]
    }
  ]
}
